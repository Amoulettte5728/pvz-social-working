						 背景主题
						 id=背景id
						 name=背景名字
						 src=背景图片或者swf路径;
						 area=这块地图可开发的矩形区域;前两个为起点坐标,后面为行列;
						 areaTileIndex:每个格子的索引范围;
						 areaTileArea:每个格子的行列坐标起始范围;
						 area="-1400,550,50,50"
						 1820 -1124 1820 1124
						 tileSize="6,6"
						  areaTileArea="12,0;0,0;24,0;24,12;12,12;0,12"
					 -->
<!--					<zbzBldItem itemId="967" bigImg="zhenbaozhuBldMc" 	aniMc="" x="1135" y="1035" />-->
					<bizBldItem itemId="966" bigImg="mengniuBldMc" 		aniMc="" x="1346" y="925" />
<!--					<bizBldItem itemId="966" bigImg="mengniuBldMc" 		aniMc="" x="1130" y="1040" />-->
