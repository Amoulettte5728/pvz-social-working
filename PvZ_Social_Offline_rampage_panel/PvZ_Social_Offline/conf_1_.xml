				<tutorial money_prize="2000" exp_prize="110"/>
				<screens>
					<!--
						 场景主题
						 如果有特殊的属性可以放这里.
						 这里要和上面的分开的原因是因为,这里的swf是按需加载的,而上面的是全部加载;
					-->
					<screen id="1"
							label="白天前院"
							swfId="pvzScreen1"/>
					<screen id="2"
							label="夜晚前院"
							swfId="pvzScreen2"/>
					<screen id="3"
							label="白天水池"
							swfId="pvzScreen3"/>
					<screen id="4"
							label="夜晚水池"
							swfId="pvzScreen4"/>
					<screen id="5"
							label="白天屋顶"
							swfId="pvzScreen5"/>
					<screen id="6"
							label="夜晚屋顶"
							swfId="pvzScreen6"/>
