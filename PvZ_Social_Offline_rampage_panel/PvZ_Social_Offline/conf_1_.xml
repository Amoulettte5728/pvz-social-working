					<resource swfId="pvzUI" label="冒险模式ui资源文件"/>
				</tdMode>
				<tdMode mode="2" name="Survival">
					<resource swfId="pvzUI" label="比赛模式的ui资源文件"/>
				</tdMode>
				<tdMode mode="102" name="RamPage">
